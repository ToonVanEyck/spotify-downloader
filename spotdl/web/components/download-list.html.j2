<div id="download-list">
    {% if client_song_downloads|length == 0 %}
    <p class="py-6 text-sm text-base-content/55">No active downloads.</p>
    {% else %}
    <ul class="divide-y divide-base-content/10">
        {% for client_song_download in client_song_downloads %}
        <li class="flex gap-3 py-4">
            {% if client_song_download.song.cover_url %}
            <img src="{{ client_song_download.song.cover_url }}" alt=""
                class="h-12 w-12 shrink-0 rounded-md object-cover" />
            {% else %}
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-md bg-base-200">
                <iconify-icon icon="clarity:music-note-line" style="font-size: 20px"></iconify-icon>
            </div>
            {% endif %}
            <div class="min-w-0 flex-1">
                <h3 class="truncate text-sm font-medium">
                    {{ client_song_download.song.name }} - {{ client_song_download.song.artist }}
                </h3>
                <p class="truncate text-xs text-base-content/60">
                    {{ client_song_download.song.album_name }}
                </p>
                <div class="mt-2 flex items-center gap-2">
                    {% if client_song_download.progress == 100 %}
                    <span class="text-xs text-success">Complete</span>
                    <a class="btn btn-ghost btn-xs btn-square"
                        data-attr="{href:'/api/download/file?file={{ client_song_download.path|urlencode|replace('/', '%2f') }}&client_id=' + $client_id}"
                        download title="Download file">
                        <iconify-icon icon="clarity:download-line" style="font-size: 18px"></iconify-icon>
                    </a>
                    {% elif client_song_download.progress == 0 %}
                    <span class="loading loading-spinner loading-xs"></span>
                    <span class="text-xs text-base-content/60">{{ client_song_download.message }}</span>
                    {% else %}
                    <progress class="progress progress-primary h-2 flex-1"
                        value="{{ client_song_download.progress }}" max="100"></progress>
                    <span class="text-xs tabular-nums text-base-content/60">
                        {{ client_song_download.progress }}%
                    </span>
                    {% endif %}
                </div>
            </div>
        </li>
        {% endfor %}
    </ul>
    {% endif %}
</div>