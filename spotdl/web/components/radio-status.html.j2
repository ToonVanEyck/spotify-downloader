<div id="radio-status" class="space-y-8">
    <section aria-labelledby="radio-sources-heading">
        <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
            <h2 id="radio-sources-heading" class="text-lg font-semibold">Source status</h2>
            <form action="/radio/check" method="post">
                <button class="btn btn-outline btn-sm" type="submit">Check now</button>
            </form>
        </div>
        <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
            {% for station in stations %}
            <article class="rounded-lg border border-base-content/15 bg-base-200 p-4">
                <div class="flex items-center justify-between gap-2">
                    <a class="link link-hover font-medium" href="{{ station.url|e }}"
                        target="_blank" rel="noopener noreferrer">{{ station.name|e }}</a>
                    <span class="badge badge-sm {% if station.enabled %}badge-primary{% else %}badge-ghost{% endif %}">
                        {{ "Monitoring" if station.enabled else "Paused" }}
                    </span>
                </div>
                <p class="mt-2 text-xs text-base-content/60">Last check: {{ station.checked|e }}</p>
                {% if station.enabled %}
                <p class="mt-1 text-xs text-base-content/60">Next check: {{ station.next_check|e }}</p>
                {% endif %}
                {% if station.error %}
                <p class="mt-2 break-words text-xs text-error" role="alert">{{ station.error|e }}</p>
                {% endif %}
            </article>
            {% endfor %}
        </div>
    </section>

    <section aria-labelledby="radio-plays-heading">
        <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
            <h2 id="radio-plays-heading" class="text-lg font-semibold">Recent radio plays</h2>
            <label for="radio-station-filter" class="flex items-center gap-2 text-sm">
                Station
                <select id="radio-station-filter" class="select select-sm" data-bind="radio_station_filter" data-ignore-morph>
                    <option value="">All stations</option>
                    {% for station in stations %}
                    <option value="{{ station.id|e }}"
                        {% if not station.enabled %}hidden disabled{% endif %}
                        data-attr-hidden="!$radio_enabled_stations.includes({{ ('|' ~ station.id ~ '|')|tojson|forceescape }})"
                        data-attr-disabled="!$radio_enabled_stations.includes({{ ('|' ~ station.id ~ '|')|tojson|forceescape }})">{{ station.name|e }}</option>
                    {% endfor %}
                </select>
            </label>
        </div>
        <p class="mb-3 text-xs text-base-content/60">
            Latest 300 plays. Initial history is included in library checks and downloads.
            Failed tracks get up to five retries after 2, 4, 8, 16, and 32 minutes,
            after normal queued downloads; a later play can be tried again.
            Only the history still visible on the source can be recovered after downtime.
        </p>
        <div class="max-h-96 overflow-auto rounded-lg border border-base-content/15">
            <table class="table table-sm">
                <thead class="sticky top-0 bg-base-200">
                    <tr><th>Played (UTC)</th><th>Station</th><th>Song</th><th>Status</th></tr>
                </thead>
                <tbody>
                    {% for play in plays %}
                    <tr data-show="$radio_station_filter === '' || $radio_station_filter === {{ play.station|tojson|forceescape }}">
                        <td class="whitespace-nowrap text-xs">{{ play.played_at[:16]|replace("T", " ")|e }}</td>
                        <td>{{ play.station|e }}</td>
                        <td class="min-w-52">
                            <span class="font-medium">{{ play.artist|e }} - {{ play.title|e }}</span>
                            {% if play.message %}<p class="mt-1 break-words text-xs text-error">{{ play.message|e }}</p>{% endif %}
                            {% if play.path %}<p class="mt-1 break-all text-xs text-base-content/60">{{ play.path|e }}</p>{% endif %}
                        </td>
                        <td>
                            <span class="badge badge-sm whitespace-nowrap {{ {'downloaded': 'badge-success', 'already collected': 'badge-info', 'failed': 'badge-error', 'downloading': 'badge-primary', 'checking': 'badge-warning'}.get(play.status, 'badge-ghost') }}">
                                {{ play.status|e }}
                            </span>
                            <p class="mt-1 whitespace-nowrap text-xs text-base-content/60">
                                {{ "Next attempt" if play.status in ('queued', 'retry') else "Attempt" }}
                                {{ play.attempt_number }} / {{ max_attempts }}
                            </p>
                            {% if play.retry_check %}
                            <p class="mt-1 whitespace-nowrap text-xs text-base-content/60">Retry after {{ play.retry_check|e }}</p>
                            {% endif %}
                        </td>
                    </tr>
                    {% else %}
                    <tr data-show="$radio_station_filter === ''"><td colspan="4" class="py-8 text-center text-base-content/60">
                        Select stations and save your Navidrome connection to start monitoring.
                    </td></tr>
                    {% endfor %}
                    {% for station in stations %}
                    {% if not plays|selectattr('station', 'equalto', station.id)|list %}
                    <tr data-show="$radio_station_filter === {{ station.id|tojson|forceescape }}">
                        <td colspan="4" class="py-8 text-center text-base-content/60">No recent plays for {{ station.name|e }}.</td>
                    </tr>
                    {% endif %}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <section aria-labelledby="radio-output-heading">
        <h2 id="radio-output-heading" class="mb-3 text-lg font-semibold">Radio terminal output</h2>
        <div class="overflow-hidden rounded-lg border border-base-content/20 bg-neutral text-neutral-content">
            <div class="border-b border-neutral-content/15 px-4 py-2 font-mono text-xs">
                radio monitor / spotdl / yt-dlp &middot; last 1,000 lines
            </div>
            <div class="h-72 overflow-auto p-4 font-mono text-xs leading-relaxed"
                data-on-load="followDownloadOutput(el)">
                <pre id="radio-output" class="m-0 whitespace-pre-wrap break-words">{{ output|default("Radio activity and download errors will appear here.", true)|e }}</pre>
            </div>
        </div>
    </section>
</div>
