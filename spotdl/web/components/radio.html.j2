{% extends "base.html.j2" %}

{% block content %}
<style>
    .radio-snow {
        position: absolute;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
    }
    .radio-snow span {
        position: absolute;
        top: 0;
        left: var(--x);
        width: 0;
        height: 100%;
        animation: radio-snowfall var(--duration) linear var(--delay) infinite;
    }
    .radio-snow span::before {
        content: "";
        display: block;
        width: var(--size);
        height: var(--size);
        border-radius: 50%;
        background: white;
        box-shadow: 0 0 2px #718096;
        opacity: .7;
    }
    @keyframes radio-snowfall {
        from { transform: translate(0, -8px); }
        to { transform: translate(var(--drift), 100%); }
    }
    @media (prefers-reduced-motion: reduce) {
        .radio-snow { display: none; }
    }
</style>
<div class="mx-auto max-w-screen-2xl space-y-8 px-4 py-8 sm:px-6 lg:px-8">
    <header>
        <h1 class="text-2xl font-semibold">Radio monitor</h1>
        <p class="mt-2 max-w-3xl text-sm text-base-content/65">
            Add the radios you want to monitor in Source status. Each source checks for new
            plays at most once every 10 minutes while the spotDL server is running.
            Navidrome library checks use the server's NAVIDROME_URL, NAVIDROME_USERNAME,
            and NAVIDROME_PASSWORD environment variables.
        </p>
    </header>

    {% if error %}
    <div class="alert alert-error" role="alert">{{ error|e }}</div>
    {% elif request.query_params.get("added") %}
    <div class="alert alert-success" role="status">Radio added. Its five most recent plays will be checked when its queue allows.</div>
    {% elif request.query_params.get("removed") %}
    <div class="alert alert-success" role="status">Radio removed. Its history has been kept.</div>
    {% elif request.query_params.get("checking") %}
    <div class="alert alert-info" role="status">Refresh requested for empty new-song queues, respecting each source's 10-minute limit. Retry deadlines are unchanged.</div>
    {% endif %}

    <div data-signals='{"radio_station_filter": "", "radio_enabled_stations": {{ ('|' ~ selected_stations|join('|') ~ '|')|tojson }}, "radio_stats": {{ radio_stats|tojson|forceescape }}}'
        data-effect="$radio_station_filter && !$radio_enabled_stations.includes('|' + $radio_station_filter + '|') && ($radio_station_filter = '')"
        data-on-load="@get('/radio/updates')">
        {% include "radio-status.html.j2" %}
    </div>
</div>
{% endblock content %}
