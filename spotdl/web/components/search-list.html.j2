<div id="search-list" data-signals='{"song_url": ""}'>
    {% macro render_item(item) %}
    <article class="card md:card-side card-bordered card-compact bg-base-100 shadow-sm">
        <figure class="aspect-square md:w-40">
            {% if item.cover_url %}
            <img src="{{ item.cover_url }}" alt="Cover for {{ item.name }}" class="aspect-square object-cover" />
            {% else %}
            <div class="flex aspect-square items-center justify-center bg-base-200 md:w-40">
                <iconify-icon icon="clarity:music-note-line" style="font-size: 32px"></iconify-icon>
            </div>
            {% endif %}
        </figure>
        <div class="card-body">
            <span class="badge badge-outline w-fit">{{ item.kind }}</span>
            <h3 class="card-title">{{ item.name }}</h3>
            {% if item.subtitle %}
            <p>{{ item.subtitle }}</p>
            {% endif %}
            <div class="card-actions mt-auto justify-end">
                <a class="btn btn-ghost btn-square" href="{{ item.url }}" target="_blank" rel="noopener noreferrer" title="Open on Spotify">
                    <iconify-icon icon="clarity:link-line" style="font-size: 24px"></iconify-icon>
                </a>
                <button class="btn btn-primary" data-on-click="$song_url = {{ item.url|tojson|forceescape }}; @post('/client/download/')">
                    <iconify-icon icon="clarity:download-line" style="font-size: 20px"></iconify-icon>
                    Download
                </button>
            </div>
        </div>
    </article>
    {% endmacro %}

    {% if error %}
    <div class="alert alert-error m-2" role="alert">
        {{ error }}
    </div>
    {% endif %}

    {% if preview %}
    <section class="mb-6" aria-labelledby="search-preview-title">
        <h2 id="search-preview-title" class="mb-3 text-xl font-semibold">Spotify link</h2>
        {{ render_item(preview) }}
    </section>
    {% endif %}

    {% for category, title in [("artists", "Artists"), ("tracks", "Tracks"), ("albums", "Albums"), ("playlists", "Playlists")] %}
    {% if suggestions and suggestions[category] %}
    <section class="mb-6" aria-labelledby="search-{{ category }}-title">
        <h2 id="search-{{ category }}-title" class="mb-3 text-xl font-semibold">{{ title }}</h2>
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3">
            {% for item in suggestions[category] %}
            {{ render_item(item) }}
            {% endfor %}
        </div>
    </section>
    {% endif %}
    {% endfor %}

    <div id="download-status" role="status" aria-live="polite"></div>
</div>
